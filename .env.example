# Client-side Flagsmith environment key (safe to expose in the browser bundle).
# Get it from Flagsmith Cloud -> Project -> Environment -> SDK Keys.
# Leave unset to run ShipCheck with the graceful `control` fallback.
VITE_FLAGSMITH_ENV_KEY=your_client_side_environment_key

# Optional: override the Flagsmith API base URL (self-hosted Flagsmith).
# VITE_FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
